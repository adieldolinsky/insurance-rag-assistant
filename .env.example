# Copy to .env on the EC2 host (chmod 600). Do not commit .env.
# On EC2 production: use an IAM instance profile — omit AWS_ACCESS_KEY_ID / SECRET.

REQUIRE_AWS_ENV=1
AWS_REGION=us-east-1

S3_BUCKET_NAME=insurance-private-mvp
KNOWLEDGE_BASE_ID=NXYJDUMTAJ
# KNOWLEDGE_BASE_DATA_SOURCE_ID=

BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

BOTO_READ_TIMEOUT=300
BOTO_CONNECT_TIMEOUT=10
BOTO_MAX_RETRY_ATTEMPTS=10

RAG_SEARCH_TYPE=HYBRID
RAG_NARROW_RESULTS=50
RAG_BROAD_RESULTS=100
RAG_RESULTS_PER_COMPANY=50
RAG_RESULTS_PER_COMPANY_BROAD=60
RAG_MAX_TOTAL_RESULTS=130
RAG_MAX_COMPARE_COMPANIES=4

PAGES_PER_CHUNK=5
INGESTION_MAX_RETRIES=15
INGESTION_RETRY_DELAY_SECONDS=10
POLICY_REGISTRY_TTL_SECONDS=30

# Optional: bind-mount host paths in docker run -v
# UPLOAD_FOLDER=/data/tmp_uploads
# OUTPUT_FOLDER=/data/tmp_outputs

LOG_LEVEL=INFO
