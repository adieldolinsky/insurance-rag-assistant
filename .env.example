# =============================================================================
# Insurance RAG — environment variables (1:1 with config.py)
# Copy to .env and adjust. Never commit .env.
# =============================================================================

# --- Startup ---
REQUIRE_AWS_ENV=1
LOG_LEVEL=INFO

# --- AWS region & credentials ---
AWS_REGION=us-east-1
# Local Docker (default): pass keys via .env — do NOT mount ~/.aws
AWS_USE_ENV_CREDENTIALS=1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# Optional, for temporary/session credentials:
# AWS_SESSION_TOKEN=
# EC2 production: set AWS_USE_ENV_CREDENTIALS=0 and omit keys (IAM instance profile)

# --- AWS resources ---
S3_BUCKET_NAME=your-s3-bucket-name
KNOWLEDGE_BASE_ID=YOUR_KB_ID
KNOWLEDGE_BASE_DATA_SOURCE_ID=YOUR_DATA_SOURCE_ID

# --- Bedrock models & agent ---
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_AGENT_ID=YOUR_AGENT_ID
BEDROCK_AGENT_ALIAS_ID=YOUR_AGENT_ALIAS_ID

# --- Lambda ETL function names ---
ADMIN_LAMBDA_NAME=Admin_Policy_ETL_Lambda
USER_LAMBDA_NAME=Lambda3_User_ETL

# --- AWS HTTP client tuning ---
BOTO_CONNECT_TIMEOUT=10
BOTO_READ_TIMEOUT=300
BOTO_MAX_RETRY_ATTEMPTS=10

# --- PDF / Docling ---
PAGES_PER_CHUNK=3

# --- Bedrock KB ingestion retry ---
INGESTION_MAX_RETRIES=15
INGESTION_RETRY_DELAY_SECONDS=10
INGESTION_RETRY_MAX_DELAY_SECONDS=120

# --- HTTP server ---
PORT=5000
BIND_HOST=0.0.0.0

# --- Container scratch paths (match docker-compose volume mounts) ---
UPLOAD_FOLDER=/app/tmp_uploads
OUTPUT_FOLDER=/app/tmp_outputs
